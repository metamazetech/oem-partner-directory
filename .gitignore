# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual Environment
venv/
Venv/
ENV/
env/
.env
.venv

# Database (keeps schema clean, excludes local run data)
*.db
*.sqlite3

# Uploaded vendor cards and logos (prevents private files uploads)
uploads/*
!uploads/.gitkeep

# IDEs and editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary patch and fix scripts
patch_*.py
fix_*.py
check_*.py
clean_*.py
powershell.exe
powershell.cmd

# Deployment Archives
*.zip

# Scratch and temporary directories
scratch/

